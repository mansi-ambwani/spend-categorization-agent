# Copy this file to ".env" and fill in what you need. Never commit the real .env file.

# --- Agent language model -------------------------------------------------
# rules  = offline, no key (default)
# gemini = free key from https://aistudio.google.com/apikey
# groq   = free key from https://console.groq.com/keys
# ollama = local Llama 3 via https://ollama.com (run: ollama pull llama3.1:8b)
AGENT_BACKEND=rules
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_MODEL=llama3.1:8b

# --- Fine-tuning (only needed if you switch to Meta's gated repo) ----------
# BASE_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
# HF_TOKEN=hf_xxx
